{
  "$defs": {
    "BackendLocation": {
      "additionalProperties": true,
      "description": "Where a definition's state lives. A state is identified by this, not by name.",
      "properties": {
        "account_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Id"
        },
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "bucket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bucket"
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "state_key": {
          "title": "State Key",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "state_key"
      ],
      "title": "BackendLocation",
      "type": "object"
    },
    "ChangeSummary": {
      "additionalProperties": true,
      "description": "Counts as terraform prints them, plus the address and actions of each change.",
      "properties": {
        "add": {
          "default": 0,
          "title": "Add",
          "type": "integer"
        },
        "change": {
          "default": 0,
          "title": "Change",
          "type": "integer"
        },
        "destroy": {
          "default": 0,
          "title": "Destroy",
          "type": "integer"
        },
        "import": {
          "default": 0,
          "title": "Import",
          "type": "integer"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/ResourceChange"
          },
          "title": "Resources",
          "type": "array"
        }
      },
      "title": "ChangeSummary",
      "type": "object"
    },
    "DefinitionResult": {
      "additionalProperties": true,
      "properties": {
        "applied_serial": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applied Serial"
        },
        "base_lineage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Lineage"
        },
        "base_serial": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Serial"
        },
        "changes": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChangeSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "definition": {
          "title": "Definition",
          "type": "string"
        },
        "module_sources": {
          "items": {
            "$ref": "#/$defs/ModuleSource"
          },
          "title": "Module Sources",
          "type": "array"
        },
        "phases": {
          "additionalProperties": {
            "$ref": "#/$defs/PhaseResult"
          },
          "propertyNames": {
            "enum": [
              "init",
              "plan",
              "apply",
              "destroy"
            ]
          },
          "title": "Phases",
          "type": "object"
        },
        "state": {
          "$ref": "#/$defs/BackendLocation"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "definition",
        "state"
      ],
      "title": "DefinitionResult",
      "type": "object"
    },
    "ModuleSource": {
      "additionalProperties": true,
      "description": "A module terraform installed for a definition, as recorded in modules.json.\n\nkind \"local\" is a path outside the definition, such as a mounted module\ncheckout; \"bundled\" is a path inside the definition or inside a module\nfetched from git or a registry.",
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "kind": {
          "enum": [
            "git",
            "local",
            "bundled",
            "registry",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref"
        },
        "sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "key",
        "source",
        "kind"
      ],
      "title": "ModuleSource",
      "type": "object"
    },
    "PhaseResult": {
      "additionalProperties": true,
      "properties": {
        "action": {
          "enum": [
            "init",
            "plan",
            "apply",
            "destroy"
          ],
          "title": "Action",
          "type": "string"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "lock_wait_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lock Wait Seconds"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "action",
        "status"
      ],
      "title": "PhaseResult",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": true,
      "description": "Observable facts about where a run came from, recorded in place of intent.",
      "properties": {
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host"
        },
        "intent": {
          "anyOf": [
            {
              "enum": [
                "deploy",
                "preview",
                "drift"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intent"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "plan_storage": {
          "default": "run",
          "enum": [
            "backend",
            "local",
            "run"
          ],
          "title": "Plan Storage",
          "type": "string"
        },
        "repository": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepositoryState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "terraform_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terraform Version"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        },
        "worker_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worker Version"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "RepositoryState": {
      "additionalProperties": true,
      "description": "The git checkout the worker ran from.",
      "properties": {
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch"
        },
        "dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dirty"
        },
        "on_tracked_ref": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "On Tracked Ref"
        },
        "sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha"
        },
        "tracked_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tracked Ref"
        }
      },
      "title": "RepositoryState",
      "type": "object"
    },
    "ResourceChange": {
      "additionalProperties": true,
      "properties": {
        "actions": {
          "items": {
            "type": "string"
          },
          "title": "Actions",
          "type": "array"
        },
        "address": {
          "title": "Address",
          "type": "string"
        },
        "importing": {
          "default": false,
          "title": "Importing",
          "type": "boolean"
        }
      },
      "required": [
        "address",
        "actions"
      ],
      "title": "ResourceChange",
      "type": "object"
    }
  },
  "$id": "tfworker.run/v1",
  "additionalProperties": true,
  "description": "One immutable record per run, written when the run ends.",
  "properties": {
    "actions": {
      "items": {
        "enum": [
          "plan",
          "apply",
          "destroy"
        ],
        "type": "string"
      },
      "title": "Actions",
      "type": "array"
    },
    "definitions": {
      "items": {
        "$ref": "#/$defs/DefinitionResult"
      },
      "title": "Definitions",
      "type": "array"
    },
    "deployment": {
      "title": "Deployment",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "run_id_generated": {
      "default": false,
      "title": "Run Id Generated",
      "type": "boolean"
    },
    "schema": {
      "const": "tfworker.run/v1",
      "default": "tfworker.run/v1",
      "title": "Schema",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "run_id",
    "deployment",
    "started_at",
    "status"
  ],
  "title": "RunRecord",
  "type": "object"
}
